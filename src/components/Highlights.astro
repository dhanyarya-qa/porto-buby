---
import { Image } from 'astro:assets';
import { highlights, resolveEvidence, certificates } from '../lib/content';
import certPreview from '../assets/mepo-certificate-preview.jpg';

// Only visual asset tied to a highlight: the Mepo certificate preview (CLAUDE.md).
const PREVIEWS: Record<string, { src: typeof certPreview; alt: string }> = {
  'certificate:mepo-pm-intern': {
    src: certPreview,
    alt: certificates.find((c) => c.id === 'mepo-pm-intern')?.title ?? '',
  },
};
---
<section id="highlights" class="band" aria-labelledby="highlights-title">
  <div class="container-page">
    <h2 id="highlights-title" class="section-title" data-reveal>Highlights</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-[1fr_1.15fr]">
      {highlights.map((h, i) => {
        const ev = resolveEvidence(h.evidence);
        const preview = PREVIEWS[h.evidence];
        return (
          <li class:list={['card flex flex-col', preview && 'card-featured md:row-span-2']} style={`--i: ${i}`} data-tilt data-reveal>
            {preview && (
              <div class="mb-5 rounded-[8px] bg-canvas-soft p-3">
                <Image src={preview.src} alt={preview.alt} widths={[480, 960]} sizes="(min-width: 1024px) 620px, (min-width: 768px) 50vw, 100vw" class="cert-3d block w-full rounded-[6px]" />
              </div>
            )}
            <h3 class="card-title pop">{h.label}</h3>
            <p class="mt-2 text-body">{h.detail}</p>
            {ev && (
              <a href={ev.href} class="link mt-auto pt-4 text-sm font-semibold" {...(ev.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {ev.external ? 'View certificate (PDF)' : 'See evidence'}<span class="sr-only">: {ev.label}</span>
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
